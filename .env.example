# Stark Lab 公式サイト (C:\dev\starklab)
NEXT_PUBLIC_SITE_URL=https://www.starklab.jp

# Supabase（published 記事の読取・anon）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 問い合わせメール通知（Resend / server-only）
# Domain Verification・DKIM・SPF が Verified であること
RESEND_API_KEY=
# 送信元（Resend で verified なドメイン）
CONTACT_FROM_EMAIL=Stark Lab <contact@starklab.jp>
# 問い合わせ通知の受信先（ソースにハードコードしない）
CONTACT_NOTIFICATION_EMAIL=starklab.system@gmail.com
# 互換エイリアス（任意）
# CONTACT_TO_EMAIL=starklab.system@gmail.com

# Analytics → SEO Engine ingest
NEXT_PUBLIC_SEO_ENGINE_URL=https://stark-seo-engine.vercel.app
# ANALYTICS_INGEST_URL=https://stark-seo-engine.vercel.app
# ANALYTICS_INGEST_SECRET=

# GA4 ブラウザ計測（プロパティ 529715123 に紐づく Measurement ID を設定）
