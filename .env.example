# Stark Lab 公式サイト (C:\dev\starklab)
NEXT_PUBLIC_SITE_URL=https://starklab.jp

# Supabase（published 記事の読取・anon）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 問い合わせメール（任意）
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Analytics → SEO Engine ingest
# 未設定時は https://stark-seo-engine.vercel.app を使用
NEXT_PUBLIC_SEO_ENGINE_URL=https://stark-seo-engine.vercel.app
# 任意: カスタム ingest base（末尾スラッシュなし）
# ANALYTICS_INGEST_URL=https://stark-seo-engine.vercel.app
